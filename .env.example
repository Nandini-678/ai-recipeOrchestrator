# Copy to .env and fill in. .env is gitignored - never commit real keys.

# --- Groq (LLM for the composer + substitution fallback) ---------------------
# Free key: https://console.groq.com/keys
GROQ_API_KEY=
# Any chat model your Groq account can serve; override without touching code.
GROQ_MODEL=llama-3.3-70b-versatile

# --- USDA FoodData Central (nutrition agent) ---------------------------------
# Free key: https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=

# --- TheMealDB (recipe dataset) ----------------------------------------------
# The public test key "1" needs no signup and is enough for this project.
THEMEALDB_API_KEY=1
