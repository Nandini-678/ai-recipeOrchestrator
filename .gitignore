# The normalized corpus IS committed: it makes the repo clone-and-run with no
# network, and it is the input every retrieval test reasons about.
# The raw API cache (same data, unnormalized) and the vector index are not --
# both are regenerated by scripts/fetch_recipes.py and RecipeIndex.build().
data/raw/*
!data/raw/.gitkeep
data/chroma/
*.sqlite3

