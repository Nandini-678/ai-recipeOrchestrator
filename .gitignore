# Environments
.venv/
venv/
.env
.streamlit/secrets.toml

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# The normalized corpus IS committed: it makes the repo clone-and-run with no
# network, and it is the input every retrieval test reasons about.
# The raw API cache (same data, unnormalized) and the vector index are not --
# both are regenerated by scripts/fetch_recipes.py and RecipeIndex.build().
data/raw/*
!data/raw/.gitkeep
data/chroma/
# per-user USDA response cache; populates on first run
data/processed/nutrition_cache.json
# per-source intermediates; only the merged corpus is committed
data/processed/themealdb.json
data/processed/recipenlg.json
*.sqlite3

# OS / editor
.DS_Store
.vscode/
.idea/
