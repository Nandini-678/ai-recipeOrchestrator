# Streamlit Community Cloud: paste these into
#   App menu -> Settings -> Secrets
# Locally, use a .env file instead -- ui/app.py bridges st.secrets into the
# environment before config loads, so the same code reads either.
#
# Both keys are optional. Without them the app still retrieves, screens for
# allergens, composes from the source instructions and validates; it just
# loses model-written prose and USDA nutrition.

GROQ_API_KEY = "your-groq-key"
GROQ_MODEL = "openai/gpt-oss-120b"
USDA_API_KEY = "your-usda-key"
